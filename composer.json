{
    "name": "cleatsquad/php-text-normalizer",
    "description": "Text normalizer and tokenizer for search and deduplication: Unicode diacritic folding plus Latin and Arabic orthographic equivalences",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "text",
        "normalization",
        "tokenizer",
        "diacritics",
        "transliteration",
        "arabic",
        "unicode",
        "search"
    ],
    "homepage": "https://github.com/CleatSquad/php-text-normalizer",
    "readme": "README.md",
    "authors": [
        {
            "name": "Mohamed El Mrabet",
            "email": "mimou78@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/CleatSquad/php-text-normalizer/issues",
        "source": "https://github.com/CleatSquad/php-text-normalizer"
    },
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "symfony/polyfill-intl-normalizer": "^1.28"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "CleatSquad\\TextNormalizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleatSquad\\TextNormalizer\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "ext-intl": "Native Unicode normalization; the polyfill is used when it is absent"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
